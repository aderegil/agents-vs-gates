+/** Maps the single-order endpoint to the API-wide `items` naming. */
+export function toGetOrderResponse(order: Order): GetOrderResponse {
+  return {
+    id: order.id,
+    status: order.status,
+    placedAt: order.placedAt,
+    currency: order.currency,
+    totalCents: totalCents(order),
+    items: order.lines.map((line) => ({
