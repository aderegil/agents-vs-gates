+/**
+ * Maps the single-order read representation. `lines` remains during its
+ * deprecation period so deployed consumers of this backward-compatible route
+ * continue to work.
+ */
+export function toOrderReadResponse(order: Order): OrderReadResponse {
+  const response = toOrderResponse(order);
+  return {
+    ...response,
+    items: order.lines.map((line) => ({
+      sku: line.sku,
+      name: line.name,
+      qty: line.qty,
+      unitPriceCents: line.unitPriceCents,
+    })),
+  };
+}
