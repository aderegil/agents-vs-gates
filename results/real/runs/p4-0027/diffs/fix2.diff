@@ -0,0 +1,11 @@
+import type { StockChecker } from "../core/ports.js";
+
+/**
+ * Placeholder until the inventory Stock API is declared in the architecture catalog and approved (ARCH-5).
+ * Reports unlimited stock, so no order is rejected for lack of stock.
+ */
+export class UnlimitedStockChecker implements StockChecker {
+  async availableQuantity(_sku: string): Promise<number> {
+    return Number.POSITIVE_INFINITY;
+  }
+}
