+/** At least one SKU is requested in a larger quantity than the inventory has available. */
+export class InsufficientStockError extends DomainError {
+  readonly code = "insufficient_stock";
+
+  constructor(readonly shortages: readonly { sku: string; requested: number; available: number }[]) {
+    super(
+      `Insufficient stock: ${shortages.map((s) => `${s.sku} (requested ${s.requested}, available ${s.available})`).join("; ")}`,
+    );
+  }
+}
+
+/** The Stock API could not be reached or answered with a server error. */
+export class StockUnavailableError extends DomainError {
+  readonly code = "stock_unavailable";
+
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+  }
+}
+
 /** The payment provider could not be reached or answered with a server error. */
 export class PaymentUnavailableError extends DomainError {
   readonly code = "payment_unavailable";
