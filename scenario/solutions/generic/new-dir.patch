+import type { InMemoryOrderRepository } from "../adapters/inMemoryOrderRepository.js";
+import { exportOrdersCsv } from "../api/legacyExport.js";
+
+/** Nightly operations extract: names the file after the run date and renders the CSV. */
+export function nightlyExtract(repository: InMemoryOrderRepository, runDate: Date): { fileName: string; content: string } {
+  const day = runDate.toISOString().slice(0, 10);
+  return { fileName: `orders-${day}.csv`, content: exportOrdersCsv(repository) };
+}
